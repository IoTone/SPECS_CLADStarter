  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">DuckLaserMain – survive the laser duck</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 hud {"hint":"HUD panel (time, best, status, play button)"}'
    - '// @input AssignableType_2 duck {"hint":"Duck turret controller on DuckRoot"}'
    - '// @input AssignableType_3 shield {"hint":"Hand-held shield controller on ShieldRoot"}'
    - '// @input AssignableType_4 lasers {"hint":"Laser pool controller on the Lasers runtime root"}'
    - '// @input AssignableType_5 audio {"hint":"Audio controller (music + SFX)"}'
    - "// @input SceneObject headCamera {\"hint\":\"World camera (the player's head). Lasers aim here.\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Gameplay</span>"}'
    - '// @ui {"widget":"group_start", "label":"Gameplay"}'
    - '// @input float triggerDistanceCm = 120 {"hint":"The duck fires when your head is closer than this (cm). The survival timer only runs inside this zone.", "widget":"slider", "min":40, "max":300, "step":5}'
    - '// @input float headHitRadiusCm = 12 {"hint":"Radius (cm) around your head that counts as a hit", "widget":"slider", "min":4, "max":30, "step":0.5}'
    - '// @input float startFireIntervalSec = 1.4 {"hint":"Seconds between shots at the start of a run", "widget":"slider", "min":0.2, "max":4, "step":0.05}'
    - '// @input float minFireIntervalSec = 0.45 {"hint":"Fastest firing interval (seconds), reached after the ramp time", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input float startLaserSpeedCmPerSec = 70 {"hint":"Laser speed (cm/s) at the start of a run", "widget":"slider", "min":20, "max":300, "step":5}'
    - '// @input float maxLaserSpeedCmPerSec = 150 {"hint":"Top laser speed (cm/s), reached after the ramp time", "widget":"slider", "min":20, "max":400, "step":5}'
    - '// @input float rampSeconds = 45 {"hint":"Seconds of survival until the duck reaches max fire rate and laser speed", "widget":"slider", "min":5, "max":180, "step":5}'
    - "// @input float aimJitterCm = 5 {\"hint\":\"Random aim offset (cm) around your head, so the shots aren't perfectly predictable\", \"widget\":\"slider\", \"min\":0, \"max\":20, \"step\":0.5}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Debug</span>"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - "// @input bool debugIgnoreProximity {\"hint\":\"Treat the player as always inside the danger zone (handy in the Lens Studio preview, where you can't walk)\"}"
    - '// @ui {"widget":"group_end"}'
